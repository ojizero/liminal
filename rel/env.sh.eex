#!/bin/sh

# Erlang distribution is off by default. bin/liminal sources this file before
# it applies its own default ("sname"), so here we see only the value that the
# operator sets.
#
# To use bin/liminal remote, rpc, stop, restart, or pid, set
# RELEASE_DISTRIBUTION to sname or name, and set your own RELEASE_COOKIE.
# The COOKIE file in the release is the same in every copy of the public
# image, so the release refuses to start with distribution on and no cookie.
RELEASE_DISTRIBUTION="${RELEASE_DISTRIBUTION:-none}"
export RELEASE_DISTRIBUTION

if [ "$RELEASE_DISTRIBUTION" != "none" ] && [ -z "$RELEASE_COOKIE" ]; then
  echo "ERROR: RELEASE_DISTRIBUTION is $RELEASE_DISTRIBUTION, but RELEASE_COOKIE is not set." >&2
  echo "Set RELEASE_COOKIE to a long random secret, or unset RELEASE_DISTRIBUTION." >&2
  exit 1
fi
