# Required in production
# ------------------------------------------------

# Secret key for signing cookies and sessions.
# Generate with: mix phx.gen.secret
# Or: openssl rand -base64 64 | tr -d '\n'
SECRET_KEY_BASE=

# Path to the SQLite database file.
# Docker Compose supplies this default; a bare release requires an explicit value.
DATABASE_PATH=/data/liminal.db

# Optional — defaults shown
# ------------------------------------------------

# User/Group ID for the container process (match your host user)
# Run `id` on your host to find your UID/GID
PUID=911
PGID=911

# Note: downloaded link preview images are stored under /data/assets.
# This path is configured at image build time, not here. To change it, rebuild
# with --build-arg ASSETS_DIR=/custom/path. See docs/DEPLOYMENT.md.

# Local default. Set the public hostname for any remote production deployment;
# it controls URL generation and the primary LiveView origin.
PHX_HOST=localhost

# Comma-separated list of additional allowed origins for LiveView WebSocket connections.
# Uses //scheme-agnostic format. PHX_HOST is always included automatically.
# PHX_CHECK_ORIGINS=//domain2.com,//domain3.com

# Port the server listens on
PORT=4000

# SQLite connection pool size
POOL_SIZE=5

# Whether new user sign-ups are allowed
SIGNUPS_ENABLED=false

# Create the database and run migrations when the release starts
AUTO_MIGRATE=true

# Logger verbosity (debug, info, notice, warning, error, critical, alert, emergency)
LOG_LEVEL=warning

# Optional DNS query for distributed node discovery
# DNS_CLUSTER_QUERY=
