#!/usr/bin/env bash
#MISE description="Run shell tests for Conventional Commit helpers"
set -euo pipefail

source "${MISE_PROJECT_ROOT}/.mise/lib/conventional-commit.sh"

assert_parse() {
  local subject=$1
  local expected_type=$2
  local expected_scope=$3
  local expected_breaking=$4
  local expected_description=$5

  if ! cc_parse_subject "$subject"; then
    echo "FAIL: expected parse success for: $subject" >&2
    exit 1
  fi

  if [[ "$CC_TYPE" != "$expected_type" || "$CC_SCOPE" != "$expected_scope" || "$CC_BREAKING" != "$expected_breaking" || "$CC_DESCRIPTION" != "$expected_description" ]]; then
    echo "FAIL: parse mismatch for: $subject" >&2
    echo "  got:      type=$CC_TYPE scope=$CC_SCOPE breaking=$CC_BREAKING description=$CC_DESCRIPTION" >&2
    echo "  expected: type=$expected_type scope=$expected_scope breaking=$expected_breaking description=$expected_description" >&2
    exit 1
  fi
}

assert_reject() {
  local subject=$1

  if cc_parse_subject "$subject"; then
    echo "FAIL: expected parse failure for: $subject" >&2
    exit 1
  fi
}

assert_parse "feat(links): save new link" feat links false "save new link"
assert_parse "fix: disable paste" fix "" false "disable paste"
assert_parse "feat!: drop support" feat "" true "drop support"
assert_parse "feat(api)!: send email" feat api true "send email"
assert_parse "FEAT(ui): mobile layout" feat ui false "mobile layout"
assert_parse "chore(AGENTS.md): document commits" chore "AGENTS.md" false "document commits"

assert_reject "Show link expiry on cards using tag or viewed grace rules."
assert_reject "Merge pull request #1"
assert_reject "feat:missing space after colon"
assert_reject "feet: wrong type"

if cc_has_breaking_change_footer $'fix: prevent races\n\nBREAKING CHANGE: config format changed'; then
  :
else
  echo "FAIL: expected BREAKING CHANGE footer detection" >&2
  exit 1
fi

echo "Conventional Commit helper tests passed."

# verify-commit task (commit-msg hook entrypoint)
tmp=$(mktemp)
trap 'rm -f "$tmp"' EXIT

printf 'feat(links): add search\n' >"$tmp"
mise run verify-commit "$tmp"

printf 'not a conventional commit\n' >"$tmp"
if mise run verify-commit "$tmp" 2>/dev/null; then
  echo "FAIL: expected verify-commit to reject non-conventional message" >&2
  exit 1
fi

printf 'Merge pull request #1 from foo/bar\n' >"$tmp"
mise run verify-commit "$tmp"

echo "verify-commit tests passed."

# setup:git-hooks idempotency
first_output=$(mise run setup:git-hooks)
second_output=$(mise run setup:git-hooks)

if [[ -z "$second_output" ]]; then
  :
else
  echo "FAIL: expected setup:git-hooks to be silent on second run, got: $second_output" >&2
  exit 1
fi

if [[ "$first_output" == "Configured core.hooksPath=.githooks" ]] || git config --local --get core.hooksPath | grep -qx '.githooks'; then
  :
else
  echo "FAIL: setup:git-hooks did not configure core.hooksPath" >&2
  exit 1
fi

echo "setup:git-hooks tests passed."
