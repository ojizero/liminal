#!/usr/bin/env bash
#MISE description="Create a GitHub release for VERSION"
set -euo pipefail

source "${MISE_PROJECT_ROOT}/.mise/lib/release-scope.sh"
source "${MISE_PROJECT_ROOT}/.mise/lib/changelog.sh"

: "${VERSION:?VERSION is required}"
: "${GH_TOKEN:?GH_TOKEN is required}"

latest_tag=$(gh release view --json tagName -q '.tagName' 2>/dev/null || echo "")
notes_file=$(mktemp)

cleanup() {
  rm -f "$notes_file"
}

trap cleanup EXIT

changelog_for_release "$VERSION" "$latest_tag" >"$notes_file"

gh release create "v${VERSION}" \
  --title "v${VERSION}" \
  --notes-file "$notes_file"
