#!/usr/bin/env bash
#MISE description="Determine if a release is required for this push"
set -euo pipefail

source "${MISE_PROJECT_ROOT}/.mise/lib/release-scope.sh"

: "${BEFORE:?BEFORE is required}"
: "${AFTER:?AFTER is required}"
: "${GITHUB_OUTPUT:?GITHUB_OUTPUT is required}"

current=$(current_version)

echo "Current version: $current"
echo "version=$current" >> "$GITHUB_OUTPUT"

if ! version_changed_in_range "$BEFORE" "$AFTER"; then
  echo "VERSION unchanged in this push; skipping release."
  echo "needs_release=false" >> "$GITHUB_OUTPUT"
  exit 0
fi

latest_tag=$(gh release view --json tagName -q '.tagName' 2>/dev/null || echo "")
released=$(released_version "$latest_tag")

echo "Released version: ${released:-<none>}"

assert_version_not_behind_release "$current" "$released"

if version_bumped "$current" "$released"; then
  echo "VERSION bumped; release required."
  echo "needs_release=true" >> "$GITHUB_OUTPUT"
else
  echo "VERSION changed but matches latest release; skipping release."
  echo "needs_release=false" >> "$GITHUB_OUTPUT"
fi
